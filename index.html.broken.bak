  <!-- Ã¢â¢ÂÃ¢â¢Â Unified Export Button Styles Ã¢â¢ÂÃ¢â¢Â -->
  <style>
    .btn-export {
      display: inline-flex; align-items: center; gap: 5px;
      padding: 7px 13px; border-radius: 8px; border: 1px solid var(--border-soft, #2d3748);
      background: var(--bg-2, #1e293b); color: var(--text-1, #cbd5e1);
      font-family: var(--font-body, 'IBM Plex Sans Arabic', sans-serif);
      font-size: 12.5px; font-weight: 500; cursor: pointer;
      white-space: nowrap;
    }
    .btn-export:hover { background: var(--primary, #5B5CEB); color: #fff;
      border-color: var(--primary, #5B5CEB); }
    .btn-export.excel:hover { background: #16a34a; border-color: #16a34a; }
    .btn-export.print:hover  { background: #0369a1; border-color: #0369a1; }
    .btn-export span { font-size: 14px; }

    /* Ã¢ââ¬Ã¢ââ¬ Print Styles Ã¢ââ¬Ã¢ââ¬ */
    @media print {
      /* Hide everything that isn't content */
      #sidebar, #topbar, .filterbar, .no-print,
      .btn, .btn-export, .btn-primary, .btn-secondary, .btn-danger,
      .nav-section, .kpi-grid, #toast-container,
      .page-header > *:not(.print-title),
      .modal-overlay, #f8-search-modal,
      [onclick], .actions-col, td:last-child .btn,
      .quick-filter-btn, .filter-select-group label + select,
      #sidebar-overlay, .mobile-menu-btn { display: none !important; }

      /* Show content area full-width */
      #app { display: block !important; }
      #page-router-outlet {
        display: block !important; width: 100%; padding: 0; margin: 0;
      }
      .page-content { padding: 0 !important; margin: 0 !important; }

      /* Table print styles */
      table { width: 100%; border-collapse: collapse; font-size: 9pt; }
      thead th {
        background: #1a1a2e !important; color: #fff !important;
        padding: 6pt 8pt; font-weight: 700;
        -webkit-print-color-adjust: exact; print-color-adjust: exact;
      }
      tbody td { padding: 4pt 8pt; border-bottom: 0.5pt solid #ccc; }
      tbody tr:nth-child(even) { background: #f5f5ff !important;
        -webkit-print-color-adjust: exact; print-color-adjust: exact; }
      .card { box-shadow: none !important; border: 1pt solid #ddd !important; }

      /* Print header auto-added */
      body::before {
        content: "Ãâ ÃÂ¸ÃÂ§Ãâ¦ ÃÂ¥ÃÂ¯Ãâ¡ÃÂ§Ãâ¦ ERP Ã¢â¬â " attr(data-print-title);
        display: block; font-size: 14pt; font-weight: 700;
        color: #1a1a2e; margin-bottom: 8pt; padding-bottom: 6pt;
        border-bottom: 2pt solid #5B5CEB;
        font-family: 'IBM Plex Sans Arabic', Tahoma, sans-serif;
      }
      @page { size: A4 landscape; margin: 12mm 10mm; }
    }
  </style>

