  <!-- Apply saved appearance settings INSTANTLY (before modules load) -->
  <script>
    (function() {
      try {
        const app = JSON.parse(localStorage.getItem('idham_appearance') || '{}');
        const root = document.documentElement;
        if (app.fontFamily) {
          root.style.setProperty('--font-body',    "'" + app.fontFamily + "', sans-serif");
          root.style.setProperty('--font-heading', "'" + app.fontFamily + "', sans-serif");
        }
        if (app.fontSize) {
          root.style.setProperty('--font-size-base', app.fontSize + 'px');
          document.body && (document.body.style.fontSize = app.fontSize + 'px');
        }
        if (app.primaryColor) {
          root.style.setProperty('--primary',      app.primaryColor);
          root.style.setProperty('--primary-dim',  app.primaryColor + '22');
          root.style.setProperty('--primary-glow', app.primaryColor + '55');
        }
      } catch(e) {}
    })();
  </script>
</head>
<body>

  <!-- Ã¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢Â -->
  <!-- Loading Screen Ã¢â¬â Ãâ ÃÂ¸Ãâ¦ ÃÂ§ÃâÃÂ§Ãâ¦ÃÂ¯ÃÂ§ÃÂ¯ ÃÂ§ÃâÃÂ­ÃÂ¯ÃÅ ÃÂ«ÃÂ©  -->
  <!-- Ã¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢Â -->
  <div id="loading-screen" style="
    position:fixed; inset:0;
    background: linear-gradient(160deg, #071a0b 0%, #0d2b12 50%, #071a0b 100%);
    display:flex; flex-direction:column; align-items:center; justify-content:center; z-index:9999;
    font-family:'IBM Plex Sans Arabic', sans-serif;
  ">
    <!-- Subtle background pattern -->
    <div style="position:absolute;inset:0;background-image:linear-gradient(rgba(212,175,55,.03) 1px,transparent 1px),linear-gradient(90deg,rgba(212,175,55,.03) 1px,transparent 1px);background-size:50px 50px;pointer-events:none;"></div>

    <div style="text-align:center; display:flex; flex-direction:column; align-items:center; gap:24px; position:relative; z-index:2;">

      <!-- Logo Icon -->
      <div style="
        width:100px; height:100px;
        background: linear-gradient(145deg, #1a5c2a 0%, #0f3d19 100%);
        border-radius:28px;
        display:flex; align-items:center; justify-content:center;
        border: 2px solid rgba(212,175,55,0.4);
        box-shadow: 0 0 0 8px rgba(212,175,55,0.06), 0 20px 50px rgba(0,0,0,0.5);
      ">
        <svg width="56" height="56" viewBox="0 0 56 56" fill="none">
          <!-- Truck body -->
          <rect x="6" y="26" width="30" height="18" rx="3" fill="#D4AF37" opacity=".9"/>
          <rect x="36" y="30" width="14" height="14" rx="3" fill="#D4AF37" opacity=".7"/>
          <!-- Wheels -->
          <circle cx="14" cy="46" r="4" fill="#0f3d19" stroke="#D4AF37" stroke-width="1.5"/>
          <circle cx="42" cy="46" r="4" fill="#0f3d19" stroke="#D4AF37" stroke-width="1.5"/>
          <!-- Wheat stalks -->
          <line x1="28" y1="22" x2="28" y2="10" stroke="#4ade80" stroke-width="1.5" stroke-linecap="round"/>
          <ellipse cx="28" cy="8" rx="3" ry="5" fill="#4ade80" opacity=".8"/>
          <line x1="24" y1="20" x2="20" y2="12" stroke="#4ade80" stroke-width="1.2" stroke-linecap="round"/>
          <ellipse cx="19" cy="10" rx="2.5" ry="4" fill="#4ade80" opacity=".6" transform="rotate(-20 19 10)"/>
          <line x1="32" y1="20" x2="36" y2="12" stroke="#4ade80" stroke-width="1.2" stroke-linecap="round"/>
          <ellipse cx="37" cy="10" rx="2.5" ry="4" fill="#4ade80" opacity=".6" transform="rotate(20 37 10)"/>
        </svg>
      </div>

      <!-- Company Name -->
      <div>
        <div style="font-size:30px; font-weight:900; color:#D4AF37; margin:0; letter-spacing:-0.5px; line-height:1.2; text-shadow:0 2px 20px rgba(212,175,55,0.3);">
          &#x646;&#x638;&#x645; &#x627;&#x644;&#x627;&#x645;&#x62f;&#x627;&#x62f; &#x627;&#x644;&#x62d;&#x62f;&#x64a;&#x62b;&#x629;
        </div>
        <div style="font-size:14px; font-weight:600; color:#4ade80; margin:6px 0 0 0; letter-spacing:.5px;">
          &#x62a;&#x648;&#x632;&#x64a;&#x639; &#x627;&#x644;&#x645;&#x648;&#x627;&#x62f; &#x627;&#x644;&#x63a;&#x630;&#x627;&#x626;&#x64a;&#x629; &#x628;&#x627;&#x644;&#x62c;&#x645;&#x644;&#x629;
        </div>
        <div style="width:120px; height:2px; background:linear-gradient(90deg,transparent,#D4AF37,transparent); margin:12px auto 0;"></div>
        <div style="font-size:12px; color:#4b7a55; margin:10px 0 0 0; font-weight:400; letter-spacing:1px;">
          &#x646;&#x638;&#x627;&#x645; &#x625;&#x62f;&#x627;&#x631;&#x629; &#x645;&#x648;&#x627;&#x631;&#x62f; &#x627;&#x644;&#x645;&#x624;&#x633;&#x633;&#x627;&#x62a;
        </div>
      </div>

      <!-- Static progress bar (no animation - fast) -->
      <div style="width:180px; height:3px; background:rgba(255,255,255,0.08); border-radius:10px; overflow:hidden;">
        <div id="splash-bar" style="height:100%; width:20%; background:linear-gradient(90deg,#D4AF37,#f5d76e); border-radius:10px;"></div>
      </div>
    </div>
  </div>
  <script>
    // ÃÂªÃâÃÂ¯Ãâ¦ ÃÂ´ÃÂ±ÃÅ ÃÂ· ÃÂ§ÃâÃÂªÃÂ­Ãâ¦ÃÅ Ãâ ÃÂ¨ÃÂ¯ÃËÃâ  animation CSS
    (function(){
      var bar = document.getElementById('splash-bar'), w = 20;
      var t = setInterval(function(){
        w = Math.min(w + 15, 90);
        if(bar) bar.style.width = w + '%';
        if(w >= 90) clearInterval(t);
      }, 200);
    })();
  </script>

  <!-- Ã¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢Â -->
  <!-- Auth Page Ã¢â¬â Ãâ ÃÂ¸Ãâ¦ ÃÂ§ÃâÃÂ§Ãâ¦ÃÂ¯ÃÂ§ÃÂ¯ ÃÂ§ÃâÃÂ­ÃÂ¯ÃÅ ÃÂ«ÃÂ© v3.0  -->
  <!-- Ã¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢ÂÃ¢â¢Â -->
    <div id="auth-page" class="auth-page hidden">

    <style>
    *, *::before, *::after { animation-duration:0.001ms!important; animation-iteration-count:1!important; transition-duration:0.001ms!important; }
    .auth-page { position:fixed;inset:0;z-index:100;background:linear-gradient(160deg,#071a0b 0%,#0d2b12 50%,#071a0b 100%);display:flex;align-items:center;justify-content:center;font-family:"IBM Plex Sans Arabic",sans-serif;overflow:hidden; }
    .auth-grid { position:absolute;inset:0;pointer-events:none;background-image:linear-gradient(rgba(212,175,55,.04) 1px,transparent 1px),linear-gradient(90deg,rgba(212,175,55,.04) 1px,transparent 1px);background-size:60px 60px; }
    .auth-wrap { position:relative;z-index:10;display:grid;grid-template-columns:58% 42%;width:100%;max-width:1040px;min-height:580px;border-radius:24px;overflow:hidden;box-shadow:0 40px 100px rgba(0,0,0,.7),0 0 0 1px rgba(212,175,55,.15); }
    @media(max-width:700px){ .auth-wrap{grid-template-columns:1fr;max-width:400px;} .auth-brand-panel{display:none;} }
    .auth-brand-panel { background:linear-gradient(160deg,#0c2412 0%,#071a0b 100%);border-left:1px solid rgba(212,175,55,.2);padding:48px 44px;display:flex;flex-direction:column;justify-content:space-between;position:relative;overflow:hidden; }
    .auth-brand-panel::before { content:"";position:absolute;top:-60px;right:-60px;width:250px;height:250px;border-radius:50%;background:rgba(212,175,55,.05);filter:blur(50px);pointer-events:none; }
    .auth-logo-box { width:66px;height:66px;border-radius:20px;background:linear-gradient(145deg,#1a5c2a 0%,#0f3d19 100%);display:flex;align-items:center;justify-content:center;border:1.5px solid rgba(212,175,55,.5);box-shadow:0 8px 28px rgba(0,0,0,.4);flex-shrink:0; }
    .auth-logo-title { font-size:20px;font-weight:900;color:#D4AF37;letter-spacing:-.3px; }
    .auth-logo-sub   { font-size:11px;color:#4ade80;font-weight:600;margin-top:3px;letter-spacing:.3px; }
    .auth-hero-title { font-size:26px;font-weight:900;color:#ffffff;line-height:1.45;margin-bottom:14px;letter-spacing:-.5px; }
    .auth-hero-title span { color:#D4AF37; }
    .auth-hero-desc { font-size:13px;color:rgba(255,255,255,.7);line-height:1.75;margin-bottom:30px;font-weight:400; }
    .auth-features { display:flex;flex-direction:column;gap:10px; }
    .auth-feat { display:flex;align-items:center;gap:14px;background:rgba(255,255,255,.04);border:1px solid rgba(212,175,55,.12);border-radius:14px;padding:12px 16px; }
    .auth-feat-icon { width:36px;height:36px;border-radius:10px;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:16px; }
    .auth-feat-text { font-size:13px;color:#ffffff;font-weight:700; }
    .auth-feat-sub  { font-size:11px;color:#6b9e7a;margin-top:2px; }
    .auth-gold-bar  { height:3px;border-radius:2px;background:linear-gradient(90deg,#D4AF37,#f5d76e,rgba(212,175,55,.2));margin-top:30px; }
    .auth-login-panel { background:#081507;border-left:1px solid rgba(212,175,55,.15);padding:48px 40px;display:flex;flex-direction:column;justify-content:center;position:relative; }
    .auth-login-title { font-size:26px;font-weight:900;color:#ffffff;margin-bottom:6px;letter-spacing:-.5px; }
    .auth-login-sub   { font-size:13px;color:#4b7a55;margin-bottom:32px;font-weight:500; }
    .auth-field { position:relative;margin-bottom:20px; }
    .auth-field label { display:block;font-size:11px;font-weight:800;color:#5a8a68;text-transform:uppercase;letter-spacing:.8px;margin-bottom:8px; }
    .auth-input-wrap { position:relative; }
    .auth-input { width:100%;box-sizing:border-box;background:rgba(212,175,55,.06);border:1.5px solid rgba(212,175,55,.2);border-radius:12px;padding:13px 44px 13px 16px;font-size:14px;color:#f1f5f9;font-family:"IBM Plex Sans Arabic",sans-serif;outline:none; }
    .auth-input::placeholder { color:#2d5a3a; }
    .auth-input:focus { border-color:rgba(212,175,55,.8);background:rgba(212,175,55,.08);box-shadow:0 0 0 3px rgba(212,175,55,.15); }
    .auth-input-icon { position:absolute;left:14px;top:50%;transform:translateY(-50%);font-size:16px;color:#2d5a3a;pointer-events:none; }
    .auth-eye-btn { position:absolute;left:12px;top:50%;transform:translateY(-50%);background:transparent;border:none;cursor:pointer;color:#4b7a55;font-size:18px;padding:2px; }
    .auth-submit { width:100%;padding:14px;border:1px solid rgba(212,175,55,.4);cursor:pointer;background:linear-gradient(135deg,#1a6b2a,#0f3d19);color:#D4AF37;font-size:15px;font-weight:800;font-family:"IBM Plex Sans Arabic",sans-serif;border-radius:12px;margin-top:4px;box-shadow:0 6px 24px rgba(0,0,0,.4);position:relative; }
    .auth-submit:disabled { opacity:.6;cursor:not-allowed; }
    .auth-progress { position:absolute;bottom:0;left:0;height:3px;width:0%;background:linear-gradient(90deg,#D4AF37,#f5d76e);border-radius:0 2px 2px 0; }
    .auth-error { background:rgba(239,68,68,.12);border:1px solid rgba(239,68,68,.25);border-radius:10px;padding:10px 14px;font-size:13px;color:#fca5a5;margin-bottom:16px;display:none; }
    .auth-error.show { display:block; }
    .auth-footer { margin-top:28px;padding-top:20px;border-top:1px solid rgba(212,175,55,.1);text-align:center; }
    .auth-footer p { font-size:11px;color:#2d5a3a;margin:3px 0; }
    .auth-footer span { color:#D4AF37;font-weight:700; }
    </style>

    <div class="auth-grid"></div>
    <div class="auth-wrap">
      <!-- Brand Panel -->
      <div class="auth-brand-panel">
        <div>
          <div style="display:flex;align-items:center;gap:16px;margin-bottom:36px;">
            <div class="auth-logo-box">
              <svg width="38" height="38" viewBox="0 0 56 56" fill="none">
                <rect x="6" y="26" width="30" height="18" rx="3" fill="#D4AF37" opacity=".9"/>
                <rect x="36" y="30" width="14" height="14" rx="3" fill="#D4AF37" opacity=".7"/>
                <circle cx="14" cy="46" r="4" fill="#0f3d19" stroke="#D4AF37" stroke-width="1.5"/>
                <circle cx="42" cy="46" r="4" fill="#0f3d19" stroke="#D4AF37" stroke-width="1.5"/>
                <line x1="28" y1="22" x2="28" y2="10" stroke="#4ade80" stroke-width="1.5" stroke-linecap="round"/>
                <ellipse cx="28" cy="8" rx="3" ry="5" fill="#4ade80" opacity=".8"/>
                <line x1="24" y1="20" x2="20" y2="12" stroke="#4ade80" stroke-width="1.2" stroke-linecap="round"/>
                <ellipse cx="19" cy="10" rx="2.5" ry="4" fill="#4ade80" opacity=".6" transform="rotate(-20 19 10)"/>
                <line x1="32" y1="20" x2="36" y2="12" stroke="#4ade80" stroke-width="1.2" stroke-linecap="round"/>
                <ellipse cx="37" cy="10" rx="2.5" ry="4" fill="#4ade80" opacity=".6" transform="rotate(20 37 10)"/>
              </svg>
            </div>
            <div>
              <div class="auth-logo-title">&#x646;&#x638;&#x645; &#x627;&#x644;&#x627;&#x645;&#x62f;&#x627;&#x62f; &#x627;&#x644;&#x62d;&#x62f;&#x64a;&#x62b;&#x629;</div>
              <div class="auth-logo-sub">&#x62a;&#x648;&#x632;&#x64a;&#x639; &#x627;&#x644;&#x645;&#x648;&#x627;&#x62f; &#x627;&#x644;&#x63a;&#x630;&#x627;&#x626;&#x64a;&#x629; &#x628;&#x627;&#x644;&#x62c;&#x645;&#x644;&#x629;</div>
