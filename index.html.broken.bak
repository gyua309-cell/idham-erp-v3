    <button class="btn btn-ghost" style="text-align:right; font-size:13px; padding:8px 10px; width:100%;" onclick="navigate('receipts'); closeAllPortalDropdowns()">&#128203; ÃÂ³Ãâ ÃÂ¯ ÃâÃÂ¨ÃÂ¶ ÃÂ¬ÃÂ¯ÃÅ ÃÂ¯</button>
    <button class="btn btn-ghost" style="text-align:right; font-size:13px; padding:8px 10px; width:100%;" onclick="navigate('payments'); closeAllPortalDropdowns()">&#128203; ÃÂ³Ãâ ÃÂ¯ ÃÂµÃÂ±ÃÂ ÃÂ¬ÃÂ¯ÃÅ ÃÂ¯</button>
  </div>

  <div id="user-dropdown-portal" class="dropdown-portal" style="width:190px;">
    <button class="btn btn-ghost" style="text-align:right; font-size:13px; padding:8px 10px; width:100%;" onclick="navigate('settings-company'); closeAllPortalDropdowns()">&#9881;&#65039; ÃÂ¥ÃÂ¹ÃÂ¯ÃÂ§ÃÂ¯ÃÂ§ÃÂª ÃÂ§ÃâÃÂ´ÃÂ±ÃÆÃÂ©</button>
    <button class="btn btn-ghost" style="text-align:right; font-size:13px; padding:8px 10px; width:100%;" onclick="navigate('settings-users'); closeAllPortalDropdowns()">&#128101; ÃÂ¥ÃÂ¯ÃÂ§ÃÂ±ÃÂ© ÃÂ§ÃâÃâ¦ÃÂ³ÃÂªÃÂ®ÃÂ¯Ãâ¦ÃÅ Ãâ </button>
    <hr style="border-color:var(--border-soft); margin:4px 0;" />
    <button class="btn btn-ghost text-bad" style="text-align:right; font-size:13px; padding:8px 10px; width:100%;" onclick="signOutUser()">&#9199;&#65039; ÃÂªÃÂ³ÃÂ¬ÃÅ Ãâ ÃÂ§ÃâÃÂ®ÃÂ±ÃËÃÂ¬</button>
  </div>

  <script>
  // Portal Dropdown Engine
  let _activePortal = null;

  function closeAllPortalDropdowns() {
    document.querySelectorAll('.dropdown-portal').forEach(p => p.classList.remove('open'));
    _activePortal = null;
  }

  function togglePortalDropdown(triggerId, portalId) {
    const trigger = document.getElementById(triggerId);
    const portal  = document.getElementById(portalId);
    if (!trigger || !portal) return;

    if (_activePortal === portalId && portal.classList.contains('open')) {
      closeAllPortalDropdowns();
      return;
    }
    closeAllPortalDropdowns();

    const rect = trigger.getBoundingClientRect();
    const portalW = parseInt(portal.style.width) || 200;
    let left = rect.left;
    // Keep inside viewport
    if (left + portalW > window.innerWidth - 10) left = window.innerWidth - portalW - 10;
    if (left < 10) left = 10;

    portal.style.top  = (rect.bottom + 8) + 'px';
    portal.style.left = left + 'px';
    portal.classList.add('open');
    _activePortal = portalId;
  }

  // Close portal dropdowns on outside click
  document.addEventListener('click', function(e) {
    if (!e.target.closest('.dropdown-portal') && !e.target.closest('.dropdown-container')) {
      closeAllPortalDropdowns();
    }
  });
  </script>
</body>
</html>
