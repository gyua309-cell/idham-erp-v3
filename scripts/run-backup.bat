@echo off
chcp 65001 > nul
echo ========================================================
echo   إدهام للمواد الغذائية - تشغيل النسخ الاحتياطي التلقائي
echo ========================================================
echo.
node "%~dp0auto-backup.mjs"
if %ERRORLEVEL% EQU 0 (
    echo.
    echo ✅ تم إنشاء النسخة الاحتياطية وحفظها بنجاح في مجلد:
    echo   E:\ادهام للمواد الغذائية\قاعدة_البيانات_والنسخ_الاحتياطي\backups
) else (
    echo.
    echo ❌ حدث خطأ أثناء تشغيل النسخ الاحتياطي!
)
echo.
pause
